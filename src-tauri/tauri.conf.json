{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsInside",
  "version": "0.3.1",
  "identifier": "com.wherestheapp.whatsinside",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WhatsInside",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "copyright": "GPL-2.0-only",
    "category": "Utility",
    "shortDescription": "Čo je v tvojom PC"
  }
}
